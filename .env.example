# Nexus Commerce - Environment Configuration Template
# Copy this file to .env and provide your local/production settings.
# NEVER commit real credentials or production secrets to version control.

# --- Backend Configuration ---
PORT=5000
BACKEND_PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/ecomm_platform
CORS_ORIGIN=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars

# Payment Gateway (Razorpay - Optional in dev, defaults to Cash on Delivery)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email / SMTP Configuration (Optional in dev - simulated and logged if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Nexus Commerce <noreply@nexuscommerce.com>"

# --- Frontend Configuration ---
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME="Nexus Commerce"

# --- AI Service Configuration ---
AI_PORT=8000
AI_ENVIRONMENT=development
