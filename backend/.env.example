# ==============================================
# Backend Environment Configuration Template
# ==============================================
# Copy this file to .env and configure the values for your environment.
# Note: Real credentials and secrets must NEVER be committed to version control.

# Server Configuration
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000/api/v1

# Database Configuration (MongoDB Connection String)
# Example local: mongodb://localhost:27017/ecomm_platform
# Example replica: mongodb://user:pass@host1:27017,host2:27017/ecomm_platform?replicaSet=rs0
MONGODB_URI=mongodb://localhost:27017/ecomm_platform

# CORS Configuration (Allowed origins, comma-separated if multiple)
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# AI Microservice URL (Used by future phase proxy/calls)
AI_SERVICE_URL=http://localhost:8000

# Logging Level (error, warn, info, http, verbose, debug, silly)
LOG_LEVEL=info

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN_DAYS=7

# Email Service (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@ecommerce.local
